{
  "name": "geokari-huisdossier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check:installation": "node scripts/check-installation.mjs",
    "customer:init": "node scripts/init-customer.mjs",
    "customer": "node scripts/customer.mjs",
    "backup": "node scripts/installation-backup.mjs backup",
    "restore": "node scripts/installation-backup.mjs restore",
    "verify": "npm test && npm run build",
    "clean": "node scripts/clean-generated.mjs",
    "import:lighting": "node scripts/import-lighting.mjs",
    "dev": "node server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs --production",
    "test": "node --test tests/*.test.mjs",
    "import:house": "node scripts/import-house.mjs",
    "import:dossier": "node scripts/import-dossier.mjs",
    "format": "prettier --write config docs scripts server src tests index.html *.json *.ts *.md"
  },
  "dependencies": {
    "express": "^5.3.0",
    "lucide-react": "^1.77.0",
    "multer": "^2.5.0",
    "polygon-clipping": "^0.15.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "suncalc": "^2.1.4",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
